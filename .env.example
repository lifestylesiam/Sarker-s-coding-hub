# Copy to .env (gitignored) and fill in. Never commit or paste real values anywhere.
# Variable names are configurable in config/settings.yaml -> credentials.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Live trading is refused unless this equals the value in settings.yaml -> trading.live_confirm_value,
# AND trading.allow_live is true, AND the CLI gets --i-understand-live. Leave empty.
QUANTLAB_ALLOW_LIVE=

# Any setting can be overridden with QUANTLAB__<SECTION>__<KEY>, e.g.
# QUANTLAB__DATA__FEED=sip
# QUANTLAB__DATA__PROVIDER=synthetic
